{
  "_comment": "PipeConnect screenshot capture. 6 slots per surface. Keys MUST match canonical slot names in capture_screenshots.py SLOTS list; content under each key is what we actually capture. Themes applied by writing palette directly to PIPE_COLORS (THEMES array lives in an IIFE).",
  "_readiness_expr": "typeof save !== 'undefined' && typeof loadLevel === 'function' && typeof showScreen === 'function' && typeof PIPE_COLORS !== 'undefined'",

  "_setup_taps": [
    ["js", "(function(){try{var s={currentLevel:120,completedLevels:Array.from({length:118},function(_,i){return i;}),levelStars:(function(){var x={};for(var i=0;i<118;i++)x[i]=(i%4===0?3:(i%3===0?2:1));return x;})(),coins:247,lives:5,maxLives:5,lastLifeTime:Date.now(),removeAds:false,unlimitedLivesPermanent:false,unlimitedLivesExpiry:0,dailyChallengeDate:'',dailyChallengeStreak:7,soundEnabled:true,musicEnabled:false,activeTheme:'default',lastLevelProgress:null,hintPack:3,hintCount:3,seasonPassUntil:0,weeklyPassUntil:0,lastSeasonGrantDate:'',lastWeeklyGrantDate:''};Object.assign(save,s);if(typeof persist==='function')persist();if(typeof updateAllUI==='function')updateAllUI();window._PALETTES={classic:{red:'#ff5252',blue:'#448aff',green:'#69f0ae',yellow:'#ffd740',purple:'#e040fb',orange:'#ff6d00',pink:'#f48fb1',teal:'#18ffff'},neon:{red:'#ff073a',blue:'#00f5ff',green:'#39ff14',yellow:'#ffff00',purple:'#bf00ff',orange:'#ff6600',pink:'#ff69b4',teal:'#00ffcc'},pastel:{red:'#ffb3ba',blue:'#bae1ff',green:'#b5ead7',yellow:'#ffffba',purple:'#e0b3ff',orange:'#ffdfba',pink:'#ffb3de',teal:'#b3fff0'},ocean:{red:'#e06c75',blue:'#61afef',green:'#98c379',yellow:'#e5c07b',purple:'#c678dd',orange:'#d19a66',pink:'#e06c75',teal:'#56b6c2'}};}catch(e){}return 'seeded';})()", 400]
  ],

