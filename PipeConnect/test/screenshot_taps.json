{
  "_comment": "PipeConnect screenshot capture \u2014 18 slots designed cross-surface so each non-gameplay screen appears once. Showcases all 7 themes (Classic + Neon + Pastel + Midnight + Ocean + Inferno + Galaxy) with Midnight + Inferno + Galaxy unlocked via seed save state. Levels are distinct across every slot. Themes applied by writing palette directly to PIPE_COLORS (THEMES array lives in an IIFE).\n\nNon-gameplay screen distribution: Themes panel \u2192 phone 06 \u00b7 Level Complete overlay \u2192 tablet_7 06 \u00b7 Stats \u2192 tablet_10 06 \u00b7 Level Select grid \u2192 tablet_7 03.",
  "_readiness_expr": "typeof save !== 'undefined' && typeof loadLevel === 'function' && typeof showScreen === 'function' && typeof PIPE_COLORS !== 'undefined'",
  "_setup_taps": [
    [
      "js",
      "(function(){try{var s={currentLevel:121,completedLevels:Array.from({length:121},function(_,i){return i;}),levelStars:(function(){var x={};for(var i=0;i<121;i++)x[i]=(i%4===0?3:(i%3===0?2:1));return x;})(),coins:2480,lives:5,maxLives:5,lastLifeTime:Date.now(),removeAds:false,unlimitedLivesPermanent:false,unlimitedLivesExpiry:0,dailyChallengeDate:'',dailyChallengeStreak:7,soundEnabled:true,musicEnabled:false,activeTheme:'default',lastLevelProgress:null,hintPack:3,hintCount:3,seasonPassUntil:0,weeklyPassUntil:0,lastSeasonGrantDate:'',lastWeeklyGrantDate:'',unlockedThemes:['midnight']};Object.assign(save,s);if(typeof persist==='function')persist();if(typeof updateAllUI==='function')updateAllUI();window._PALETTES={classic:{red:'#ff5252',blue:'#448aff',green:'#69f0ae',yellow:'#ffd740',purple:'#e040fb',orange:'#ff6d00',pink:'#f48fb1',teal:'#18ffff'},neon:{red:'#ff073a',blue:'#00f5ff',green:'#39ff14',yellow:'#ffff00',purple:'#bf00ff',orange:'#ff6600',pink:'#ff69b4',teal:'#00ffcc'},pastel:{red:'#ffb3ba',blue:'#bae1ff',green:'#b5ead7',yellow:'#ffffba',purple:'#e0b3ff',orange:'#ffdfba',pink:'#ffb3de',teal:'#b3fff0'},midnight:{red:'#ff4d6d',blue:'#5390f5',green:'#3ddc97',yellow:'#ffd166',purple:'#b18cff',orange:'#ff9a3c',pink:'#ff70a6',teal:'#4cc9f0'},ocean:{red:'#e06c75',blue:'#61afef',green:'#98c379',yellow:'#e5c07b',purple:'#c678dd',orange:'#d19a66',pink:'#e06c75',teal:'#56b6c2'},fire:{red:'#ff4500',blue:'#ff8c00',green:'#ffd700',yellow:'#ff6347',purple:'#ff1493',orange:'#ff7f50',pink:'#ff69b4',teal:'#ff6600'},galaxy:{red:'#9b59b6',blue:'#3498db',green:'#1abc9c',yellow:'#f1c40f',purple:'#8e44ad',orange:'#e67e22',pink:'#e91e63',teal:'#16a085'}};}catch(e){}return 'seeded';})()",
