    <!-- AdMob App ID — required for AdMob mediation adapter -->
    <!-- Get from: apps.admob.com → Your App → App Settings -->
    <key>GADApplicationIdentifier</key>
    <string>ca-app-pub-ENTER_YOUR_ADMOB_APP_ID</string>

    <!-- Required for AdMob's SKAdNetwork attribution -->
    <key>SKAdNetworkItems</key>
    <array>
        <dict><key>SKAdNetworkIdentifier</key><string>cstr6suwn9.skadnetwork</string></dict>
