  "_setup_taps": [
    [
      "js",
      "(function(){try{var s={currentLevel:50,completedLevels:Array.from({length:50},function(_,i){return i;}),levelStars:(function(){var x={};for(var i=0;i<50;i++)x[i]=(i%4===0?3:(i%3===0?2:1));return x;})(),coins:1430,lives:5,maxLives:5,lastLifeTime:Date.now(),removeAds:false,unlimitedLivesPermanent:false,unlimitedLivesExpiry:0,dailyChallengeDate:'',dailyChallengeStreak:7,soundEnabled:true,musicEnabled:false,activeTheme:'default',lastLevelProgress:{level:50},hintPack:3,hintCount:3,seasonPassUntil:0,weeklyPassUntil:0,lastSeasonGrantDate:'',lastWeeklyGrantDate:'',unlockedThemes:['default','primary','orchid','midnight','forest','ocean','mono']};Object.assign(save,s);if(typeof persist==='function')persist();if(typeof updateAllUI==='function')updateAllUI();window._ATP={default:{c1:'#e8447e',c2:'#0fa89b',c3:'#dd9a10'},primary:{c1:'#e23b3b',c2:'#2563d8',c3:'#e8b400'},orchid:{c1:'#c44fd1',c2:'#3aa6a0',c3:'#d98a3d'},midnight:{c1:'#ff5d8f',c2:'#33d6c8',c3:'#ffc24b'},forest:{c1:'#b2503a',c2:'#3f7d4e',c3:'#caa53a'},ocean:{c1:'#d35d7e',c2:'#2a7fb8',c3:'#3ec0ad'},mono:{c1:'#3a3f53',c2:'#8088a3',c3:'#b3852f'}};window._applyAT=function(id,mid){var p=window._ATP[id]||window._ATP.default;if(typeof PIPE_COLORS!=='undefined')Object.assign(PIPE_COLORS,p);['c1','c2','c3'].forEach(function(k){if(p[k])document.body.style.setProperty('--'+k,p[k]);});save.activeTheme=id;if(mid){document.body.classList.add('midnight');document.documentElement.dataset.theme='midnight';}else{document.body.classList.remove('midnight');document.documentElement.dataset.theme='';}if(typeof persist==='function')persist();};}catch(e){}return 'seeded';})()",
      400
