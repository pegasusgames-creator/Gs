<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- KIDS SHELL (Google Play Families) — docs/KIDS_SHELL.md.
         No POST_NOTIFICATIONS / RECEIVE_BOOT_COMPLETED / receivers: kids apps
         never send notifications. Gate: scripts/check_families_compliance.py -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Families: an app that targets children must not collect the
         advertising ID. play-services-ads merges this permission in — strip it. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Android 11+ package visibility: needed to bind the device
         text-to-speech engine (letter names, phonics, words). No app
         packages are queried — kids cross-promo stays empty until another
         Pegasus KIDS app is live. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="ABC Learning"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PegasusKids"
        android:hardwareAccelerated="true"
        android:pageSizeCompat="enabled">

        <!-- Privacy Sandbox ad-services config shipped by play-services-ads -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <!-- AdMob App ID — Google TEST ID until scripts/set_app_ids.py sets the real one.
             The AdMob app must be configured as child-directed in the AdMob console. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>

        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
