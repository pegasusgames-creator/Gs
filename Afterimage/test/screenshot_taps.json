  "_setup_taps": [
    [
      "js",
      "(function(){try{var s={currentLevel:50,completedLevels:Array.from({length:50},function(_,i){return i;}),levelStars:(function(){var x={};for(var i=0;i<50;i++)x[i]=(i%4===0?3:(i%3===0?2:1));return x;})(),coins:2480,lives:5,maxLives:5,lastLifeTime:Date.now(),removeAds:false,unlimitedLivesPermanent:false,unlimitedLivesExpiry:0,dailyChallengeDate:'',dailyChallengeStreak:7,soundEnabled:true,musicEnabled:false,activeTheme:'default',lastLevelProgress:{level:50},hintPack:3,hintCount:3,seasonPassUntil:0,weeklyPassUntil:0,lastSeasonGrantDate:'',lastWeeklyGrantDate:'',unlockedThemes:['default','mint','sunset','midnight','violet','ember','mono']};Object.assign(save,s);if(typeof persist==='function')persist();if(typeof updateAllUI==='function')updateAllUI();window._ATP={default:{you:'#0fb5c9',echo:'#e85d5d',plate:'#d29922',exit:'#2ea043'},mint:{you:'#2ea871',echo:'#d96941',plate:'#c9a227',exit:'#3a86ff'},sunset:{you:'#f2784b',echo:'#7a5cd6',plate:'#e0b228',exit:'#2ea043'},midnight:{you:'#37e0e0',echo:'#ff6b6b',plate:'#f2c14e',exit:'#9be37d'},violet:{you:'#8b5cf6',echo:'#ef6292',plate:'#d29922',exit:'#22b8a0'},ember:{you:'#ff8c1a',echo:'#c0392b',plate:'#ffd166',exit:'#7fc97f'},mono:{you:'#3a4a63',echo:'#8a93a6',plate:'#b08d2f',exit:'#4f7d52'}};window._applyAT=function(id,mid){var p=window._ATP[id]||window._ATP.default;if(typeof PIPE_COLORS!=='undefined')Object.assign(PIPE_COLORS,p);['you','echo','plate','exit'].forEach(function(k){if(p[k])document.body.style.setProperty('--'+k,p[k]);});save.activeTheme=id;if(mid){document.body.classList.add('midnight');document.documentElement.dataset.theme='midnight';}else{document.body.classList.remove('midnight');document.documentElement.dataset.theme='';}if(typeof persist==='function')persist();};}catch(e){}return 'seeded';})()",
      400
