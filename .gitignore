# Signing credentials — never commit
keystore.jks
keystore.properties
*.jks
*.keystore
*.pfx
*.p12
keystores/
*Seed Phrase*
*seed_phrase*
*SEED_PHRASE*

# PEM upload-key reset certificates contain only public certs (no
# private key) so are technically shareable, but kept local so future
# resets don't leak the previous key cert into history.
upload_certificate.pem
upload_certificate.der

# Firebase per-app config — contains API keys, treat as sensitive
**/google-services.json

# Android build outputs — never commit
**/build/
**/.gradle/
**/*.apk
**/*.aab
**/local.properties
**/.cxx/

# Release archives (generated locally, re-creatable)
*.zip
_release/

# Python build artifacts
__pycache__/
*.pyc

# Sensitive personal/business documents (kept locally, never committed)
docs/*.pdf
*ЄДР*
*Виписка*
*Голодяєва*

# GitHub Pages files staged here for convenience — canonical home is
# the separate pegasusgames-creator.github.io repo, never commit here
/index.html
/privacy.html
/google*.html
/promo.json

# IDE
.idea/
**/*.iml
.DS_Store

