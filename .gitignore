# Signing credentials — never commit. plaintext password in
# keystore.properties is gradle-mandated; gitignore enforces never-shared.
keystore.jks
keystore.properties
*.jks
*.keystore
*.pfx
*.p12
*.pem
*.der
keystores/
local.properties
*Seed Phrase*
*seed_phrase*
*SEED_PHRASE*

# PEM upload-key reset certificates contain only public certs (no
# private key) so are technically shareable, but kept local so future
# resets don't leak the previous key cert into history.
upload_certificate.pem
upload_certificate.der

# Firebase per-app config — contains API keys, treat as sensitive
**/google-services.json

# Android build outputs — never commit
**/build/
**/.gradle/
**/*.apk
**/*.aab
**/local.properties
**/.cxx/

# Release archives (generated locally, re-creatable)
*.zip
_release/
release_aabs/

# Gemini AI image-generation artifacts dropped in store/ folders
# during design exploration. The ship listings use the wrapped
# 01.png-07.png set; the Gemini images are local-only references.
Gemini_Generated_Image_*.png

# Python build artifacts
__pycache__/
*.pyc

# Sensitive personal/business documents (kept locally, never committed)
docs/*.pdf
*ЄДР*
*Виписка*
*Голодяєва*

# GitHub Pages files staged here for convenience — canonical home is
# the separate pegasusgames-creator.github.io repo, never commit here
/index.html
/privacy.html
/google*.html
/promo.json
/icons/

# IDE
.idea/
**/*.iml
.DS_Store

# Python scripts (internal tooling)
scripts/gen_store_assets.py
scripts/gen_store_listings_1.py
scripts/fix_gamehtml_ads.py
scripts/fix_duplicate_handlers.py
scripts/fix_duplicate2.py
scripts/add_login_streak.py
scripts/add_retention_features.py
scripts/add_translations.py

# local backup copies (keystore / PEPK zip / cert backups — never commit)
*.bak1

# Play Console PEPK / app-signing download artifacts (downloaded per app, not source)
pepk*.jar
pepk-src.jar
*_pepk.zip
encryption_public_key.pem
