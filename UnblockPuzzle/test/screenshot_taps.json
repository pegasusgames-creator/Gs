{
  "_comment": "UnblockPuzzle screenshot capture. Uses JS-based showScreen/initGame so the same config works across phone, tablet_7, tablet_10.",
  "_readiness_expr": "typeof state !== 'undefined' && typeof initGame === 'function' && typeof showScreen === 'function'",

  "_setup_taps": [
    ["js", "(function(){try{var s={coins:247,lives:5,currentLevel:120,completedLevels:Array.from({length:118},function(_,i){return i+1;}),levelStars:(function(){var x={};for(var i=1;i<=118;i++)x[i]=(i%4===0?3:(i%3===0?2:1));return x;})(),removeAds:false,activeTheme:'classic',hintPack:0,seasonPassUntil:0,weeklyPassUntil:0,lastSeasonGrantDate:'',lastWeeklyGrantDate:'',unlimitedLivesUntil:0,lastLifeTime:Date.now(),dailyChallengeDate:'',dailyChallengeStreak:7,soundEnabled:true,musicEnabled:false,hapticsEnabled:true,lastLevelProgress:null};Object.assign(state,s);if(typeof saveState==='function')saveState();if(typeof updateHUD==='function')updateHUD();if(typeof updateMenuScreen==='function')updateMenuScreen();}catch(e){}return 'seeded';})()", 400]
  ],

  "01_deep_gameplay":     [["js", "showScreen('gameScreen');initGame(120,false);'ok';", 2200]],
  "02_early_gameplay":    [["js", "showScreen('gameScreen');initGame(5,false);'ok';", 2200]],
  "03_level_complete":    [["js", "(function(){showScreen('gameScreen');initGame(60,false);setTimeout(function(){var ov=document.getElementById('levelCompleteOverlay');if(ov){var stars=ov.querySelector('.lc-stars,#lcStars');if(stars)stars.textContent='⭐⭐⭐';var lvl=ov.querySelector('#lcLevel');if(lvl)lvl.textContent='Level 60';ov.classList.add('active');ov.style.display='flex';}else{if(typeof showWinOverlay==='function')showWinOverlay();}},400);})();'ok';", 2500]],
  "04_missions_panel":    [["js", "showScreen('dailyScreen');if(typeof initDailyScreen==='function')initDailyScreen();'ok';", 2200]],
  "05_stats":             [["js", "showScreen('statsScreen');if(typeof renderStats==='function')renderStats();setTimeout(function(){if(typeof injectRankCard==='function')injectRankCard();},250);'ok';", 2200]],
  "06_levels_grid":       [["js", "showScreen('levelScreen');if(typeof buildLevelGrid==='function')buildLevelGrid();'ok';", 2200]],
  "07_menu":              [],

  "tablet_7_01_deep_gameplay":  [["js", "showScreen('gameScreen');initGame(85,false);'ok';", 2200]],
  "tablet_7_02_early_gameplay": [["js", "showScreen('gameScreen');initGame(30,false);'ok';", 2200]],

  "tablet_10_01_deep_gameplay": [["js", "showScreen('gameScreen');initGame(140,false);'ok';", 2200]],
  "tablet_10_02_early_gameplay":[["js", "showScreen('themeScreen');'ok';", 2000]]
