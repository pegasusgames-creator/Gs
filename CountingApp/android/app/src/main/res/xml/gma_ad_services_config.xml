<?xml version="1.0" encoding="utf-8"?>
<!-- KIDS SHELL: no interest-based Privacy Sandbox APIs (Topics, Protected
     Audience, attribution) may be activated in a child-directed app. -->
<ad-services-config>
    <attribution-reporting allowAllToActivate="false" />
    <custom-audiences allowAllToActivate="false" />
    <topics allowAllToActivate="false" />
    <protected-signals allowAllToActivate="false" />
    <ad-selection-service allowAllToActivate="false" />
</ad-services-config>
