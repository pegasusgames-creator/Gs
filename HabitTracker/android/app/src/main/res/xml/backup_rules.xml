<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (API 23-30): the user's own habits (WebView
     localStorage) + reminder schedule travel to their Google account backup
     and come back on a new phone / reinstall. Nothing else is backed up. -->
<full-backup-content>
    <include domain="root" path="app_webview/Default/Local Storage/" />
    <include domain="root" path="app_webview/Local Storage/" />
    <include domain="sharedpref" path="reminders.xml" />
</full-backup-content>
