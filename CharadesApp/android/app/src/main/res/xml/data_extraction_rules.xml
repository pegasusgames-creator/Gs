<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup + device-to-device transfer: same scope as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
        <include domain="sharedpref" path="reminders.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
        <include domain="sharedpref" path="reminders.xml" />
    </device-transfer>
</data-extraction-rules>
