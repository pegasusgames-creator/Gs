{
  "_comment": "Sokoban screenshot capture — gameplay-only. 500-level LEVELS (valid loadLevel indices 0-499, display level = idx+1). _setup_taps seeds a mid-campaign save (tutorial done, all 7 themes owned) and defines window._applySK(themeId) — writes the theme's real palette (THEMES region, exported as window._SK_THEMES) into PIPE_COLORS + the board role CSS vars + midnight chrome, no Themes screen — and window._boardSK(idx,frac), which loads a level and plays that fraction of its stored solution instantly so every slot is a distinct mid-solve board. 11 slots = 11 distinct levels; themes cycle so each palette (and Midnight twice) appears on a live board.",
  "_readiness_expr": "typeof save !== 'undefined' && typeof loadLevel === 'function' && typeof SOLUTIONS !== 'undefined' && typeof skSnap === 'function'",
  "_setup_taps": [
    [
      "js",
      "(function(){try{localStorage.setItem('soko_tutorialDone','1');localStorage.setItem('tutorialDone','1');save.currentLevel=480;save.completedLevels=Array.from({length:480},function(_,i){return i;});save.levelStars=(function(){var x={};for(var i=0;i<480;i++)x[i]=(i%4===0?2:3);return x;})();save.coins=2480;save.hintCount=3;save.dailyChallengeStreak=7;save.unlockedThemes=['default','pine','harbor','midnight','candy','desert','ink'];save.sokoRun=null;save.lastLevelProgress=null;persist();}catch(e){}window._applySK=function(id){var t=(window._SK_THEMES||[]).filter(function(x){return x.id===id;})[0];if(!t)return;save.activeTheme=id;Object.keys(t.palette).forEach(function(k){PIPE_COLORS[k]=t.palette[k];document.body.style.setProperty('--'+k,t.palette[k]);});if(id==='midnight'){document.body.classList.add('midnight');document.documentElement.dataset.theme='midnight';}else{document.body.classList.remove('midnight');document.documentElement.dataset.theme='';}};window._boardSK=function(i,f){showScreen('game');loadLevel(i);var l=sokoUnRLE(SOLUTIONS[i]);var n=Math.floor(l.length*f);for(var k=0;k<n;k++)moveDir(l[k].toUpperCase(),true);skSnap();skHud();};return 'ok';})()",
      600
    ]
  ],
